# Copy to .env.local and fill in. Never commit a filled-in copy:
# .env* is gitignored and must stay that way.
#
# Every value here is populated in Phase 4 (backend wiring). The app builds
# and runs without them; only the API routes and Edge Function need them.

# Supabase — project URL and the browser-safe anon key.
# The anon role is INSERT-only on the two chat tables and can read nothing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role. SERVER ONLY — bypasses row level security.
# Never expose this to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — powers the chat widget through /api/chat. Server only.
ANTHROPIC_API_KEY=

# Resend — transactional email for lead alerts and the lead-loss fallback.
RESEND_API_KEY=

# Upstash Redis — rate limits /api/chat and /api/lead. Fails open on outage.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
